# Cloudflare R2 配置
# 从 Cloudflare Dashboard 获取这些值

# 账户 ID (在 Dashboard 右侧边栏)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# R2 API 凭据 (从 "Manage R2 API tokens" 获取)
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# 存储桶名称 (您创建的存储桶名称)
R2_BUCKET_NAME=blog-media-shannon

# 公共访问 URL (如果配置了自定义域名，使用自定义域名)
# 选项 1: 使用自定义域名 (推荐)
R2_PUBLIC_URL=https://media.shannonwang.top

# 选项 2: 使用 Cloudflare 默认域名
# R2_PUBLIC_URL=https://pub-xxxxxxxxx.r2.dev

# 网站配置 (可选)
NEXT_PUBLIC_WEBSITE_URL=https://shannonwang.top